# WasteLink Backend — copy to .env and fill in values
# Production: https://wastelink-3lgu.onrender.com

PORT=5000
NODE_ENV=production

DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-xxxxx.us-east-1.aws.neon.tech:5432/neondb?sslmode=require
DATABASE_SSL=true

JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=change_me
RESET_SUPER_ADMIN_PASSWORD=false

PAYMENT_MODE=manual
AUTO_PAYOUT_ON_VERIFY=false
DEFAULT_PAYMENT_PROVIDER=SIMULATION
SIMULATE_MOBILE_MONEY=true

# Smoke tests (optional, local only)
BASE_URL=https://wastelink-3lgu.onrender.com/api
PICKER_IDENTIFIER=
PICKER_PASSWORD=
AGENT_IDENTIFIER=
AGENT_PASSWORD=
SUPER_ADMIN_IDENTIFIER=
SUPER_ADMIN_PASSWORD=
COLLECTION_POINT_ID=
