# WasteLink Backend — copy to .env and fill in values (never commit .env)

PORT=5000
NODE_ENV=development

# PostgreSQL connection string (Neon, local Postgres, etc.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_SSL=true

JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Created on first boot if missing (change before production)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change_me
RESET_SUPER_ADMIN_PASSWORD=false

# Demo / simulated mobile money (no real transfers)
PAYMENT_MODE=manual
AUTO_PAYOUT_ON_VERIFY=false
DEFAULT_PAYMENT_PROVIDER=SIMULATION
SIMULATE_MOBILE_MONEY=true

# Optional — local smoke tests only (leave blank if unused)
BASE_URL=http://localhost:5000/api
PICKER_IDENTIFIER=
PICKER_PASSWORD=
AGENT_IDENTIFIER=
AGENT_PASSWORD=
SUPER_ADMIN_IDENTIFIER=
SUPER_ADMIN_PASSWORD=
COLLECTION_POINT_ID=
