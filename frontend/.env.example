# WasteLink Frontend — copy to .env for local dev (never commit .env)

# Local backend:
# VITE_API_BASE_URL=http://localhost:5000/api
#
# Production API (set in Vercel/host dashboard, not in git):
# VITE_API_BASE_URL=https://your-api-host.example.com/api

VITE_API_BASE_URL=http://localhost:5000/api

# Require login for picker / agent / admin routes
VITE_AUTH_ENFORCED=true
